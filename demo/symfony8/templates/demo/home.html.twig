{% extends 'base.html.twig' %}

{% block title %}Fragment Kit Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Fragment Kit Demo',
        intro: 'This page embeds Twig fragments with {ignore_errors: true}. Without this bundle, HTTP error statuses from sub-requests (403/404) still crash the parent with a 500. With FragmentKit, the parent stays healthy and the fallback template is rendered.',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Healthy fragment', kind: 'detail', testid: 'demo-case-ok'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--success">200</span>{% endblock %}
        {% block section_body %}{{ render(controller('App\\Controller\\DemoController::okFragment'), {ignore_errors: true}) }}{% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Forbidden fragment', kind: 'detail', testid: 'demo-case-forbidden'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--warning">403</span>{% endblock %}
        {% block section_body %}{{ render(controller('App\\Controller\\DemoController::forbiddenFragment'), {ignore_errors: true}) }}{% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Missing fragment', kind: 'detail', testid: 'demo-case-missing'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--warning">404</span>{% endblock %}
        {% block section_body %}{{ render(controller('App\\Controller\\DemoController::missingFragment'), {ignore_errors: true}) }}{% endblock %}
    {% endembed %}
{% endblock %}
